<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles exactly lib/Runtime/Application/**; may reference Shared + Domain. -->

  <PropertyGroup>
    <AssemblyName>ProjectJianghu.Core.Application</AssemblyName>
    <RootNamespace>ProjectJianghu.Core.Application</RootNamespace>
    <!-- Empty by design until Stage 05/06 (use cases). -->
    <AllowEmptyLayer>true</AllowEmptyLayer>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(LibRuntimeDir)Application/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="ProjectJianghu.Core.Shared.csproj" />
    <ProjectReference Include="ProjectJianghu.Core.Domain.csproj" />
  </ItemGroup>

</Project>
